# Server-to-server secret. Never use NEXT_PUBLIC_ or ship this to a browser.
FACE_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters
FACE_DATA_DIR=/data
FACE_DETECTOR_MODEL=/models/detector.onnx
FACE_EMBEDDING_MODEL=/models/arcface.onnx
FACE_PREVIEW_ORIGINS=https://dinhthong-video-proxy.tdt4903.workers.dev
FACE_PREVIEW_SIZE=960
FACE_ORT_PROVIDERS=CPUExecutionProvider
FACE_ORT_THREADS=4
FACE_DECODE_WORKERS=8
FACE_DETECTOR_WORKERS=2
FACE_DETECTOR_BATCH=8
FACE_EMBEDDING_BATCH=32
FACE_MAX_IMAGES=5000
FACE_MAX_FACES=30000
FACE_CLUSTER_CHUNK=2500
FACE_DETECT_THRESHOLD=0.60
FACE_CLUSTER_SIMILARITY=0.68
FACE_MERGE_SIMILARITY=0.82
FACE_ASSIGN_SIMILARITY=0.75
FACE_AMBIGUITY_MARGIN=0.08
